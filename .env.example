# Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional live threat-intelligence integrations
GOOGLE_WEB_RISK_API_KEY=
VIRUSTOTAL_API_KEY=

# Composio connections: SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
# Set keys through Vercel's secure environment-variable settings.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_SLACK_AUTH_CONFIG_ID=
SENTRA_APP_ORIGIN=https://sentra-ai-7lij.vercel.app
# Set true only AFTER configuring/verifying these settings in Composio.
COMPOSIO_CALLBACK_VERIFICATION_ENABLED=false
COMPOSIO_READ_ONLY_SCOPES_VERIFIED=false

# Server-only shared protection secret; matching SHA256 digest lives in sentra_private.
# Generate 32 random bytes; never commit the value. Production fails closed without it.
SENTRA_SERVER_SECRET=
